@@ -121,8 +121,12 @@
 # }
 
 # SASL {
+option(WITH_SASL_CYRUS "With Cyrus SASL (libsasl2) for GSSAPI/Kerberos (non-Windows)" ON)
 if(WIN32)
   set(with_sasl_default ON)
+elseif(NOT WITH_SASL_CYRUS)
+  # PLAIN, SCRAM and OAUTHBEARER do not need libsasl2
+  set(with_sasl_default ON)
 else()
   if(PkgConfig_FOUND)
     pkg_check_modules(SASL libsasl2)
@@ -154,10 +158,13 @@
     set(WITH_SASL_OAUTHBEARER ON)
     list(APPEND BUILT_WITH "SASL_SCRAM SASL_OAUTHBEARER")
   endif()
-  if(NOT WIN32)
-    set(WITH_SASL_CYRUS ON)
+  if(NOT WIN32 AND WITH_SASL_CYRUS)
     list(APPEND BUILT_WITH "SASL_CYRUS")
+  else()
+    set(WITH_SASL_CYRUS OFF)
   endif()
+else()
+  set(WITH_SASL_CYRUS OFF)
 endif()
 # }
 
